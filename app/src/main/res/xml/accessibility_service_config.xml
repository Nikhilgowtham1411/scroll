<?xml version="1.0" encoding="utf-8"?>
<!--
    Scope is limited to the supported social apps only. Android will not deliver events
    or window content from any other app to this service.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/accessibility_description"
    android:accessibilityEventTypes="typeViewScrolled|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canPerformGestures="true"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="50"
    android:packageNames="com.instagram.android,com.google.android.youtube,com.facebook.katana,com.facebook.lite,com.zhiliaoapp.musically,com.ss.android.ugc.trill" />
